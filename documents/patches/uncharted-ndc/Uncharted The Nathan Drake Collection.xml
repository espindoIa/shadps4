<!--
Workarounds for Uncharted: The Nathan Drake Collection (CUSA02320).
See documents/Uncharted-NDC.md for how to install them.

The game asserts that the end-of-pipe tick of an older frame was already written
(ndlib/render/fg-draw-mgr.cpp:234). Under emulation the GPU thread can fall behind while it
compiles shaders, so the check fires even though the frame completes later. Both entries turn the
conditional jump that skips the assert ("jne ok" after "cmp qword [frameParams+0xa08], 0") into an
unconditional one.
-->
<Patch>
    <TitleID>
        <ID>CUSA02320</ID>
    </TitleID>
    <!-- Verified on 01.00 in shadps4-emu/shadPS4#5038. Ignored on every other version. -->
    <Metadata Title="Uncharted: The Nathan Drake Collection"
              Name="Remove GPU EOP tick assert (Uncharted 1)"
              Note="Avoids the m_gfxEopTick assert when gameplay starts."
              Author="shadPS4 community"
              PatchVer="1.0"
              AppVer="01.00"
              AppElf="eboot.bin"
              isEnabled="true">
        <PatchList>
            <Line Type="bytes" Address="0x008d277f" Value="eb"/>
        </PatchList>
    </Metadata>
    <!--
    Version independent variant, NOT verified against the game binary. It searches for
    "disp32 0xa08, imm8 0, jne +0x3b" and patches the jne. Enable it only if you are not on 01.00,
    and check shad_log.txt for "Applied patch: Remove GPU EOP tick assert (any version)".
    -->
    <Metadata Title="Uncharted: The Nathan Drake Collection"
              Name="Remove GPU EOP tick assert (any version)"
              Note="Experimental pattern based variant of the 01.00 patch."
              Author="shadPS4 community"
              PatchVer="1.0"
              AppVer="01.02"
              AppElf="eboot.bin"
              isEnabled="false">
        <PatchList>
            <Line Type="mask" Address="08 0A 00 00 00 75 3B" Offset="5" Value="eb"/>
        </PatchList>
    </Metadata>
</Patch>
